<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Gravador.Cli</RootNamespace>
    <!-- gravador-cli, e nao gravador: o Windows nao distingue maiusculas, entao `gravador.exe`
         e `Gravador.exe` (a janela) sao o MESMO arquivo. Com nomes distintos os dois cabem na
         mesma pasta e compartilham o runtime self-contained — 160 MB instalados em vez de 264. -->
    <AssemblyName>gravador-cli</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gravador.Core\Gravador.Core.csproj" />
  </ItemGroup>

</Project>
