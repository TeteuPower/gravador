<UserControl x:Class="Gravador.App.Views.Pages.PaginaConta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,20,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Conta Claude" Style="{StaticResource Titulo}"/>
            <TextBlock Style="{StaticResource Fraco}" Margin="0,0,0,18"
                       Text="O Claude lê a transcrição e as capturas de tela da reunião e devolve resumo, decisões e pendências."/>

            <!-- ================= Estado ================= -->
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LuzConta" Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{StaticResource TextoFraco}"/>
                        <TextBlock x:Name="TxtEstadoConta" Text="Verificando..." Margin="9,0,0,0"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtDescricaoConta" Style="{StaticResource Fraco}" Margin="18,7,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="BtnEntrar" Content="Entrar com a conta Claude" Click="AoEntrar"/>
                        <Button x:Name="BtnManual" Content="Entrar colando o código" Click="AoEntrarManual" Margin="8,0,0,0"
                                Style="{StaticResource BotaoDiscreto}"/>
                        <Button x:Name="BtnSair" Content="Sair desta conta" Click="AoSair" Margin="8,0,0,0"
                                Style="{StaticResource BotaoDiscreto}" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel x:Name="PainelCodigo" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Fraco}" Margin="0,0,0,7"
                                   Text="Autorize no navegador e cole aqui o código que a página mostrar:"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtCodigo"/>
                            <Button Grid.Column="1" Content="Concluir" Click="AoConcluirManual" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="TxtMensagemConta" Style="{StaticResource Fraco}" Margin="0,12,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- ================= Resumo ================= -->
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <TextBlock Text="Resumo da reunião" FontWeight="SemiBold" FontSize="14"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Modelo" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <ComboBox Grid.Column="1" x:Name="CmbModelo" IsEditable="True"/>
                    </Grid>

                    <CheckBox x:Name="ChkResumirAoFinal" Content="Pedir o resumo assim que a gravação terminar" Margin="0,14,0,0"/>
                    <CheckBox x:Name="ChkEnviarCapturas" Content="Mandar as capturas de tela junto com o texto"/>

                    <TextBlock Text="Instrução do resumo" Style="{StaticResource Secao}"/>
                    <TextBox x:Name="TxtPrompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Salvar" Click="AoSalvar" MinWidth="110"/>
                        <Button Content="Voltar ao texto de fábrica" Click="AoRestaurarPrompt" Margin="8,0,0,0"
                                Style="{StaticResource BotaoDiscreto}"/>
                        <TextBlock x:Name="TxtSalvo" Style="{StaticResource Fraco}" VerticalAlignment="Center"
                                   Margin="14,0,0,0" Foreground="{StaticResource Bom}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= Nota honesta ================= -->
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <TextBlock Text="Por que o Claude não faz a transcrição" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Style="{StaticResource Fraco}" Margin="0,8,0,0"
                               Text="Os modelos do Claude leem texto, imagem e PDF — não leem áudio. Mandar o som para ele não é possível, e prometer isso aqui seria mentira."/>
                    <TextBlock Style="{StaticResource Fraco}" Margin="0,8,0,0"
                               Text="O que ele faz é o passo seguinte, e é onde ele é melhor que um transcritor: lê a transcrição junto com as telas que você capturou e a linha do tempo (inclusive os trechos em que você estava mudo) e devolve o que ficou decidido, o que ficou pendente e o que vale voltar a ouvir."/>
                    <TextBlock Style="{StaticResource Fraco}" Margin="0,8,0,0"
                               Text="Para ter a transcrição, escolha um motor em Configurações › Transcrição. Sem nenhum, a pasta da sessão continua pronta para você arrastar inteira para dentro de qualquer IA."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
