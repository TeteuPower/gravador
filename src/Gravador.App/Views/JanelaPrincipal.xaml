<Window x:Class="Gravador.App.Views.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:paginas="clr-namespace:Gravador.App.Views.Pages"
        Title="Gravador" Height="720" Width="1000" MinHeight="560" MinWidth="820"
        Background="{StaticResource Fundo}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Navegação ================= -->
        <Border Grid.Column="0" Background="{StaticResource Fundo}" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <TextBlock Text="Gravador" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtVersao" Style="{StaticResource Fraco}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Estado, sempre visível: é a pergunta que a pessoa faz mais vezes. -->
                <Border DockPanel.Dock="Bottom" Margin="14,10,14,16" CornerRadius="10" Padding="12,10"
                        Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LuzEstado" Width="8" Height="8" Fill="{StaticResource TextoFraco}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtEstadoCurto" Text="Parado" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtCronometroLateral" Text="00:00:00" FontSize="21" FontWeight="Light"
                                   Margin="0,6,0,0" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="AbaGravar" Style="{StaticResource Aba}" Content="Gravar" IsChecked="True"
                                 Checked="AoTrocarAba" Tag="gravar"/>
                    <RadioButton x:Name="AbaSessoes" Style="{StaticResource Aba}" Content="Gravações"
                                 Checked="AoTrocarAba" Tag="sessoes"/>
                    <RadioButton x:Name="AbaConfig" Style="{StaticResource Aba}" Content="Configurações"
                                 Checked="AoTrocarAba" Tag="config"/>
                    <RadioButton x:Name="AbaConta" Style="{StaticResource Aba}" Content="Conta Claude"
                                 Checked="AoTrocarAba" Tag="conta"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ================= Conteúdo ================= -->
        <Grid Grid.Column="1">
            <paginas:PaginaGravar x:Name="PgGravar"/>
            <paginas:PaginaSessoes x:Name="PgSessoes" Visibility="Collapsed"/>
            <paginas:PaginaConfiguracoes x:Name="PgConfig" Visibility="Collapsed"/>
            <paginas:PaginaConta x:Name="PgConta" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
