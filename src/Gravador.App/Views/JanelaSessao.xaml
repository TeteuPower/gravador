<Window x:Class="Gravador.App.Views.JanelaSessao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gravação" Height="800" Width="1240" MinHeight="600" MinWidth="960"
        Background="{StaticResource Fundo}" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Cabeçalho ================= -->
        <Border Grid.Row="0" Padding="24,18,24,14" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TxtTitulo" Style="{StaticResource Titulo}" Text="Gravação"/>
                    <TextBlock x:Name="TxtMeta" Style="{StaticResource Fraco}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="BtnTranscrever" Content="Transcrever" Click="AoTranscrever"/>
                    <Button x:Name="BtnTraduzir" Content="Traduzir" Click="AoTraduzir" Margin="8,0,0,0"/>
                    <Button x:Name="BtnResumir" Content="Resumir com o Claude" Click="AoResumir" Margin="8,0,0,0"/>
                    <Button Content="Abrir a pasta" Style="{StaticResource BotaoDiscreto}" Click="AoAbrirPasta" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Corpo ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Linha do tempo e slides -->
            <Border Grid.Column="0" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,12,14">
                    <StackPanel>
                        <TextBlock Text="Slides e capturas" Style="{StaticResource Secao}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ListaQuadros">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" CornerRadius="8" Background="{StaticResource Superficie}"
                                            BorderBrush="{StaticResource Borda}" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonUp="AoClicarQuadro" Tag="{Binding Caminho}">
                                        <StackPanel>
                                            <Image Source="{Binding Imagem}" Stretch="Uniform" MaxHeight="150" Margin="4,4,4,2"/>
                                            <TextBlock Margin="8,2,8,6" FontSize="11" Foreground="{StaticResource TextoFraco}">
                                                <Run Text="{Binding Carimbo}" FontFamily="Consolas"/> <Run Text="{Binding Rotulo}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtSemQuadros" Style="{StaticResource Fraco}" Text="Nenhuma imagem nesta sessão." Visibility="Collapsed"/>

                        <TextBlock Text="Linha do tempo" Style="{StaticResource Secao}"/>
                        <ItemsControl x:Name="ListaLinhaDoTempo">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Carimbo}" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextoFraco}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Rotulo}" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Textos -->
            <Grid Grid.Column="1" Margin="18,12,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="AbaResumo" Style="{StaticResource Aba}" Content="Resumo" Tag="resumo" Checked="AoTrocarTexto" IsChecked="True"/>
                    <RadioButton x:Name="AbaTraducao" Style="{StaticResource Aba}" Content="Tradução" Tag="traducao" Checked="AoTrocarTexto"/>
                    <RadioButton x:Name="AbaTranscricao" Style="{StaticResource Aba}" Content="Transcrição original" Tag="transcricao" Checked="AoTrocarTexto"/>
                    <RadioButton x:Name="AbaConversaMd" Style="{StaticResource Aba}" Content="Conversa" Tag="conversa" Checked="AoTrocarTexto"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Cartao}" Margin="0" Padding="0">
                    <TextBox x:Name="TxtCorpo" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                             Padding="18,14" FontSize="13" FontFamily="{StaticResource Fonte}"/>
                </Border>
            </Grid>

            <!-- Conversa -->
            <Border Grid.Column="2" BorderBrush="{StaticResource Borda}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,8">
                        <TextBlock Text="Conversar sobre esta sessão" FontWeight="SemiBold"/>
                        <Button Content="Recomeçar" Style="{StaticResource BotaoDiscreto}" HorizontalAlignment="Right"
                                Click="AoRecomecarConversa" Padding="6,2" FontSize="11"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" x:Name="RolagemConversa" VerticalScrollBarVisibility="Auto" Padding="16,0,12,0">
                        <StackPanel x:Name="PainelConversa">
                            <TextBlock x:Name="TxtConversaVazia" Style="{StaticResource Fraco}" Margin="0,8,0,0"
                                       Text="Pergunte qualquer coisa sobre o que foi dito ou mostrado. O Claude lê a transcrição e os slides pelas ferramentas do Gravador — só o trecho que a pergunta precisa."/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="16,8,16,14">
                        <TextBlock x:Name="TxtAtividade" Style="{StaticResource Fraco}" FontSize="11" Margin="0,0,0,6" Visibility="Collapsed"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtPergunta" AcceptsReturn="False" MinHeight="38"
                                     KeyDown="AoTeclarNaPergunta" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" x:Name="BtnEnviar" Content="Enviar" Click="AoEnviar" Margin="8,0,0,0"
                                    Style="{StaticResource BotaoPrincipal}" Background="{StaticResource Acento}"
                                    BorderBrush="{StaticResource Acento}" Foreground="#12141C" Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Rodapé de estado ================= -->
        <Border Grid.Row="2" Padding="24,8" BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0"
                Background="{StaticResource Superficie}">
            <Grid>
                <TextBlock x:Name="TxtEstado" Style="{StaticResource Fraco}" Text=""/>
                <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoDiscreto}" HorizontalAlignment="Right"
                        Click="AoCancelar" Visibility="Collapsed" Padding="8,2" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
